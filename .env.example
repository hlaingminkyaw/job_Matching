# Supabase → Project Settings → Data API / API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Server-only. Bypasses row-level security — never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Bearer token guarding /api/cron/sync-jobs. Without it the route refuses to
# run rather than serving as an open endpoint that spends Gemini quota.
# Generate one with:  openssl rand -hex 32
CRON_SECRET=
