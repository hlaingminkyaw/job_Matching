# Supabase → Project Settings → Data API / API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Server-only. Bypasses row-level security — never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Bearer token guarding /api/cron/sync-jobs. Without it the route refuses to
# run rather than serving as an open endpoint that spends Gemini quota.
# Generate one with:  openssl rand -hex 32
CRON_SECRET=

# --- Telegram job alerts ---------------------------------------------

# From @BotFather. Server-only: this token *is* the bot — anyone holding it can
# read and send everything it can. Never prefix it with NEXT_PUBLIC_.
TELEGRAM_BOT_TOKEN=

# The bot's public @name, without the @. Shipped to the browser for the
# "Open the bot" link, which is fine — a bot username is public by design.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=mm_tech_job_alerts_bot

# Guards /api/telegram/webhook, which answers /start with the caller's chat ID
# and /stop by unsubscribing them. Telegram sends it back as the
# X-Telegram-Bot-Api-Secret-Token header; without it the route refuses to run,
# since otherwise anyone who guessed the URL could unsubscribe other people.
# Generate one with:  openssl rand -hex 32
# Then register the webhook (HTTPS only — it does nothing on localhost):
#   curl -X POST "https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/setWebhook" \
#     -H "Content-Type: application/json" \
#     -d '{"url":"https://<host>/api/telegram/webhook",
#          "secret_token":"<this value>","allowed_updates":["message"]}'
TELEGRAM_WEBHOOK_SECRET=
